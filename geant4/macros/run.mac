# run.mac
# Batch execution macro for condor-sim
# Usage: condorSim run.mac

# Initialize geometry and physics
/run/initialize

# Verbose output
/run/verbose 0
/event/verbose 0
/tracking/verbose 0

# Set random number seed (can override)
/random/setSeed 123456

# Configure primary generator
/gps/particle proton
/gps/pos/centre 0. 0. 7000. km
/gps/energy 1.0 GeV

# Run simulation
/run/beamOn 10

# Finish
exit
